# Used only by `vite dev` to forward /api requests to your backend.
VITE_BACKEND_URL=http://localhost:8000

# For production builds when the API lives on a different origin
# (your backend must then allow this site's origin via CORS).
# Leave unset if the API is served from the same origin under /api.
# VITE_API_URL=https://api.example.com/api
